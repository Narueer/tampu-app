APP_NAME=TAMPU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# base de datos
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tampu
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=single
LOG_LEVEL=debug

# contacto y archivos
CONTACTO_CORREO=contacto@tampu.pe
ARCHIVOS=local
# Correos (avisos y codigos). Con 'log' solo quedan en storage/logs y no se pide confirmar el correo.
# Para enviarlos de verdad usa Brevo (gratis, 300 al dia; funciona en Render, que bloquea SMTP):
#   1) crea tu cuenta en brevo.com  2) Senders: agrega y verifica tu Gmail
#   3) SMTP & API > API Keys: crea una clave  4) pon aqui:
#   MAIL_MAILER=brevo   BREVO_API_KEY=xkeysib-...   MAIL_FROM_ADDRESS=tu_correo_verificado@gmail.com
# (En tu computadora tambien sirve Gmail por SMTP: MAIL_MAILER=smtp MAIL_HOST=smtp.gmail.com MAIL_PORT=587 ...)
MAIL_MAILER=log
BREVO_API_KEY=
MAIL_FROM_ADDRESS=no-responder@tampu.pe
MAIL_FROM_NAME=TAMPU

# Asistente virtual con IA (opcional). Sin IA_CLAVE responde solo con sus reglas.
# IA_PROVEEDOR: gemini (gratis, aistudio.google.com/apikey), groq (gratis, console.groq.com/keys) o anthropic (de pago)
IA_PROVEEDOR=groq
IA_CLAVE=
IA_MODELO=
# Respaldo opcional si el principal está saturado o tarda (otro proveedor, con su propia clave)
IA_RESPALDO_PROVEEDOR=gemini
IA_RESPALDO_CLAVE=
# Segundos máximos de espera a la IA (después responden las reglas)
IA_TIEMPO=2.5

# Tareas automáticas (recordatorios del planificador, resumen de los domingos y copia de seguridad diaria).
# Inventa una clave larga y pon en cron-job.org que visite cada hora: https://TU-PAGINA/tareas/ESA_CLAVE
TAREAS_CLAVE=
# Texto del curso en el pie de la página (déjalo vacío para quitarlo)
# TAMPU_CREDITO=
