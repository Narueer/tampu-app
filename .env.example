APP_NAME=TAMPU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# base de datos
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tampu
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=single
LOG_LEVEL=debug

# contacto y archivos
CONTACTO_CORREO=contacto@tampu.pe
ARCHIVOS=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-responder@tampu.pe
MAIL_FROM_NAME=TAMPU
