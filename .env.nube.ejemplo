# variables para la nube (Render). Copiarlas en Environment del servicio.
APP_NAME=TAMPU
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:PEGAR_AQUI_LA_CLAVE
APP_URL=https://tampu.onrender.com
APP_LOCALE=es
APP_TIMEZONE=America/Lima
LOG_CHANNEL=stderr

# base de datos en Supabase (Connect > Session pooler)
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.REFERENCIA_DEL_PROYECTO
DB_PASSWORD=CONTRASENA_DE_LA_BASE
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database

# fotos y documentos en Supabase Storage (Storage > S3 Connection)
ARCHIVOS=supabase
SUPABASE_URL=https://REFERENCIA_DEL_PROYECTO.supabase.co
SUPABASE_REGION=us-east-1
SUPABASE_S3_KEY=ACCESS_KEY_ID
SUPABASE_S3_SECRET=SECRET_ACCESS_KEY
SUPABASE_BUCKET_FOTOS=fotos
SUPABASE_BUCKET_DOCUMENTOS=documentos

# correo del equipo que se muestra en Contacto
CONTACTO_CORREO=correo_del_equipo@gmail.com

# opcional: enviar correos de verdad con Gmail (contraseña de aplicación)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=correo_del_equipo@gmail.com
# MAIL_PASSWORD=contrasena_de_aplicacion
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=correo_del_equipo@gmail.com
# MAIL_FROM_NAME=TAMPU
